# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoiceflow?schema=public"

# Optional. Only needed if `prisma migrate dev`'s automatic shadow database
# creation fails in your environment (e.g. `npx prisma dev`'s local instance,
# where the main database is literally named `template1` and Postgres won't
# let CREATE DATABASE ... TEMPLATE template1 run against it while connections
# are open). Point this at a separate, empty database on the same server.
SHADOW_DATABASE_URL=""

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Shared secret that authorizes calls to /api/cron/recurring-invoices.
# Generate the same way as AUTH_SECRET. Required only if you use recurring
# invoices and want them generated automatically on a schedule.
CRON_SECRET=""
